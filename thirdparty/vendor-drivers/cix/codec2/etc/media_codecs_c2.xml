<!-- Verbatim copy of CIX's vendor/cix_proprietary codec2 media_codecs_c2.xml
     (branch cix-radxa-o6).  The c2.cix.* components are backed by
     libcix_v4l2_codec2_components.so and drive the MVX VPU over V4L2.  Kept
     here so this overlay is self-contained; if your BSP already installs this
     file, drop the PRODUCT_COPY_FILES line for it in cix-codec2.mk. -->

<MediaCodecs>
    <Decoders>
        <MediaCodec name="c2.cix.avc.decoder" type="video/avc" >
            <Limit name="size" min="144x144" max="8192x8192" />
            <Limit name="alignment" value="2x2" />
            <Limit name="block-size" value="16x16" />
            <Limit name="blocks-per-second" min="1" max="7776000" />
            <Limit name="bitrate" range="1-480000000" />
            <Limit name="concurrent-instances" max="32" />
            <Limit name="performance-point-7680x4320" range="60-60" />
            <Feature name="adaptive-playback" />
        </MediaCodec>

