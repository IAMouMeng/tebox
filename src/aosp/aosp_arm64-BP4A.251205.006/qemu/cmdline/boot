# Kernel / androidboot cmdline for aosp_arm64 (CVD-style vendor on QEMU ranchu).
# One token per line; blank lines and # comments are ignored.
# GPU backend (virgl / gfxstream / mali) comes from src/aosp/<variant>/GPU via
# scripts/boot-qemu.sh — do not hardcode androidboot.tebox.gpu here.

console=ttyAMA0,115200
earlycon=pl011,0x9000000
loglevel=4
androidboot.console=ttyAMA0
androidboot.hardware=ranchu
androidboot.selinux=permissive
# gralloc (stub vs minigbm) is set by scripts/boot-qemu.sh from GPU file.
androidboot.zygote=zygote64
androidboot.init_fatal_reboot_target=
rdinit=/init
module.sig_enforce=0
