<?xml version="1.0" encoding="utf-8"?>
<!-- Host Mali-G720 via tebox-mali; vulkan.mali.so is on the vendor image.
     PackageManager only accepts decimal version= (Integer.parseInt); hex
     like 0x00402000 parses as 0 → hasSystemFeature(vulkan.version, 1.1)
     fails and AnTuTu marks GPU 3D scenes Not Supported.
     4210688 = 0x00404000 = Vulkan 1.4 (matches cmd gpu vkjson apiVersion). -->
<permissions>
    <feature name="android.hardware.vulkan.level" version="1" />
    <feature name="android.hardware.vulkan.version" version="4210688" />
    <feature name="android.hardware.vulkan.compute" version="0" />
</permissions>
