on early-init
    # 64-bit-only guest (no AArch32): ColorOS's mediaserverwrapper must exec
    # mediaserver64; the default 32-bit mediaserver cannot run and leaves
    # every MediaPlayer call hanging (video wallpaper ANR, blocked input).
    setprop ro.mediaserver.64b.enable true
    setprop ro.hardware ranchu
    setprop ro.zygote zygote64
    setprop debug.renderengine.backend skiaglthreaded
    setprop ro.vendor.build.version.sdk 36
    setprop ro.vendor.build.security_patch 2025-12-05
    setprop dalvik.vm.dex2oat64 true
    # The GSI already exposes its software C2 AIDL store. Its HIDL input
    # surface fallback requires an OMX HAL which this vendor does not have.
    setprop media.c2.hal.selection aidl
    # -1 creates the framework's in-process GraphicBufferSource when the
    # component store does not implement its own input surface.
    setprop debug.stagefright.c2inputsurface -1
    # /data is mounted by initramfs before early_hal starts KeyMint.
    mkdir /data/misc/qemu-keymint 0700 root root
    restorecon_recursive /data/misc/qemu-keymint
    # Soft wificond is bind-mounted from initramfs (rootfs label). Relabel
    # before class main so init can start it as wificond_exec.
    restorecon /system/bin/wificond
    # libcompiler_rt.so from qemu/init/system-overlay carries the no-op QTI
    # Performance natives (patches/qti-perf-stub); bind-mounted from the
    # initramfs (rootfs-labelled), zygote preloads it.
    restorecon /system/lib64/libcompiler_rt.so

on init
    restorecon_recursive /dev/dri
    # The dir is created before policy load and stays tmpfs-labelled; apps
    # are then denied DMA-BUF heap allocations (software codecs, SoundPool).
    restorecon_recursive /dev/dma_heap

# ColorOS display overlay without the 160px rounded corners and the notch
# (patches/display-overlay). Resources load it from /system/product/overlay,
# an overlayfs init mounts over /my_product/overlay and friends; a bind on a
# lower file is invisible through it, so bind on top before PackageManager.
on post-fs
    mount none /vendor/etc/tebox/display-overlay.apk /system/product/overlay/android_framework_res_overlay.display.product.25821.apk bind

# ColorOS UI tier (COUI reads it when an app starts). At 1 (high end) COUI
# panels and dialogs leave their background transparent for a window blur,
# but SurfaceFlinger blur is off here, so they render see-through; at 3 (low
# end) they draw opaque backgrounds. system_server must start at 1: at 3 it
# pins threads to a "super big core" this VM lacks and crashes
# (ActivityStarterExtImpl.setThreadAffinitySuperBigCore, index -1). It reads
# the level once, so 3 is set only after boot, for apps started later.
on zygote-start
    setprop persist.sys.oplus.anim_level 1

on property:sys.boot_completed=1
    setprop persist.sys.oplus.anim_level 3

# The initramfs already mounts unencrypted userdata; no vold decrypt event follows.
on post-fs-data
    trigger nonencrypted

on property:sys.boot_completed=1
    # settings is a shell script, not an init service executable. Use the shell
    # domain explicitly so init can launch it and the plugged-in VM stays awake.
    exec_background u:r:shell:s0 shell shell -- /system/bin/sh /system/bin/settings put global stay_on_while_plugged_in 1

# Opt-in local serial diagnostics for this bring-up image.
on init && property:ro.boot.qemu_debug=1
    chcon u:object_r:console_device:s0 /dev/hvc0
    start qemu-debug-shell

service qemu-debug-shell /system/bin/sh
    disabled
    console hvc0
    user root
    group root shell log readproc
    seclabel u:r:shell:s0

on early-boot
    start vendor.health-default

on boot
    start vendor.health-default

# TCP ADB when the host launcher passes androidboot.qemu_adb=1 (default).
# Initramfs clears ro.adb.secure so adbd skips RSA; use the GSI adbd binary.
# Hosts whose VirGL renderer has a hardware encoder (VideoToolbox, V4L2)
# expose c2.mesa.avc.encoder through /vendor/etc/media_codecs_tebox_video.xml.
on early-init && property:ro.boot.tebox.video_encode=1
    setprop ro.media.xml_variant.codecs _tebox_video

on boot && property:ro.boot.qemu_adb=1
    # QEMU forwards to 10.0.2.15. Keep early ADB reachable; EthernetService
    # subsequently provisions eth0 through DHCP and registers routes and DNS
    # with ConnectivityService. Do not override its default routing here.
    exec u:r:vendor_init:s0 root root -- /system/bin/ip link set eth0 up
    exec u:r:vendor_init:s0 root root -- /system/bin/ip addr replace 10.0.2.15/24 dev eth0
    setprop service.adb.tcp.port 5555
    setprop sys.usb.config adb
    start adbd

on property:sys.boot_completed=1 && property:ro.boot.qemu_adb=1
    # Android netd replaces the initial Linux routing rules. Restrict this
    # extra lookup to the QEMU host subnet so TCP debugging can send replies.
    exec u:r:vendor_init:s0 root root -- /system/bin/ip rule add priority 9000 to 10.0.2.0/24 lookup main
    exec_background u:r:shell:s0 shell shell -- /system/bin/sh /system/bin/settings put global adb_enabled 1

# ColorOS GSI without its setup wizard (com.coloros.bootreg): mark setup done,
# otherwise PhoneWindowManager ignores Home/Recents ("user setup is in
# progress"). ColorOS hides the navigation bar for its immersive apps; keep it.
on property:sys.boot_completed=1
    exec_background u:r:shell:s0 shell shell -- /system/bin/cmd settings put global device_provisioned 1
    exec_background u:r:shell:s0 shell shell -- /system/bin/cmd settings put secure user_setup_complete 1
    exec_background u:r:shell:s0 shell shell -- /system/bin/cmd settings put secure nav_bar_force_visible 1

# Once per userdata: the default video live wallpaper stays black here; use
# SystemUI's static ImageWallpaper (patches/coloros-setup). A wallpaper the
# user picks later is kept.
on property:sys.boot_completed=1 && property:persist.vendor.tebox.wallpaper=
    exec_background u:r:su:s0 root root -- /system/bin/app_process -Djava.class.path=/vendor/etc/tebox/set-wallpaper.dex /system/bin SetWallpaper
    setprop persist.vendor.tebox.wallpaper image
