cc_binary {
    name: "android.hardware.dumpstate-service",
    relative_install_path: "hw",
    vendor: true,
    srcs: [
        "Dumpstate.cpp",
        "main.cpp",
    ],
    shim_srcs: ["cutils/properties.cpp"],
    shared_libs: [
        "libbinder_ndk",
        "liblog",
        "android.hardware.dumpstate-V1-ndk",
    ],
    init_rc: ["android.hardware.dumpstate-service.rc"],
    vintf_fragments: ["android.hardware.dumpstate-service.xml"],
    cflags: ["-DLOG_TAG=\"dumpstate-default\""],
}
